APP_NAME=GoodHair Backend
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/goodhair

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

LOCAL_TIMEZONE=Asia/Ho_Chi_Minh

# Kỳ lương: 0 = trọn tháng dương lịch (mặc định). Đặt 1-28 nếu chốt lương
# giữa tháng — vd 25 nghĩa là "lương tháng X" tính từ 26 tháng trước đến 25
# tháng X. PAYROLL_PAYDAY chỉ để hiển thị ngày dự kiến chi trả (tháng sau).
PAYROLL_CUTOFF_DAY=0
PAYROLL_PAYDAY=5

# In hoá đơn ra máy in nhiệt tại quầy qua QZ Tray. Tạo cặp khoá bằng:
#   python scripts/generate_qz_cert.py   (hoặc poetry run python ...)
# Dùng ĐƯỜNG DẪN TƯƠNG ĐỐI (không phải tuyệt đối) — vì cùng 1 giá trị này
# phải chạy được cả trên máy local lẫn trong container (dev bind-mount /app,
# prod dùng volume qz_certs:/app/certs, xem docker-compose.prod.yml). Bỏ
# trống thì tính năng in tắt.
QZ_PRIVATE_KEY_PATH=certs/qz_private_key.pem
QZ_CERTIFICATE_PATH=certs/qz_certificate.pem

# Origin được phép gọi API (CORS), phân tách bằng dấu phẩy.
# Prod thêm origin thật, vd: https://goodhair.vn
CORS_ORIGINS=http://localhost:3002

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
